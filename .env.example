# PostgreSQL connection (Render, Supabase, Neon, university PostgreSQL, etc.)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/falcon_pbl

# Use a long random value in production.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Initial password generation during db:seed:v2
# Recommended: random. Optional legacy/predictable mode: derived.
INITIAL_PASSWORD_MODE=random
